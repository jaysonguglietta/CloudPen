{
  "name": "cloudpen-control-plane",
  "version": "0.2.0-rc.1",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev --hostname 127.0.0.1",
    "prebuild": "node scripts/clean-dist.mjs",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "node scripts/start-local.mjs",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "security:audit:all": "npm audit --audit-level=high",
    "security:audit:exceptions": "node scripts/audit-exceptions.mjs",
    "security:check": "node scripts/security-check.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "sbom": "npm sbom --sbom-format=cyclonedx > cloudpen-sbom.cdx.json"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.51.2",
    "@cloudflare/workers-types": "^5.20260811.1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitejs/plugin-rsc": "^0.5.34",
    "eslint": "^10.8.1",
    "globals": "^17.9.0",
    "react-server-dom-webpack": "^19.2.8",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "typescript-eslint": "^8.67.0",
    "vinext": "^0.2.1",
    "vite": "^8.2.1",
    "wrangler": "^4.121.0"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  },
  "type": "module"
}
