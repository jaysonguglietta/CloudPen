# Local development only. The development identity is honored only on loopback
# when the launcher explicitly sets CLOUDPEN_LOCAL_MODE=1. Production must use trusted Sites identity headers.
CLOUDPEN_LOCAL_DEV_EMAIL=local-admin@cloudpen.invalid

# Comma-separated, case-insensitive authorization lists.
CLOUDPEN_ADMIN_EMAILS=admin@example.com
CLOUDPEN_OPERATOR_EMAILS=
CLOUDPEN_REVIEWER_EMAILS=
CLOUDPEN_VIEWER_EMAILS=

# Generate a unique high-entropy value for each environment. Never commit it.
CLOUDPEN_PLAN_SIGNING_KEY=
PUBLIC_APP_ORIGIN=http://127.0.0.1:3000
