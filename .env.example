# Local development only. The development identity is honored only on loopback
# when the launcher explicitly sets CLOUDPEN_LOCAL_MODE=1. Production must use trusted Sites identity headers.
CLOUDPEN_LOCAL_DEV_EMAIL=local-admin@cloudpen.invalid

# Comma-separated, case-insensitive authorization lists.
CLOUDPEN_ADMIN_EMAILS=admin@example.com
CLOUDPEN_OPERATOR_EMAILS=
CLOUDPEN_REVIEWER_EMAILS=
CLOUDPEN_VIEWER_EMAILS=

# Local tests may opt into an in-memory non-exportable RSA key. Never enable this on hosted deployments.
CLOUDPEN_EPHEMERAL_SIGNER=

# Production-only external KMS signer. Keep tokens out of source and local shell history.
CLOUDPEN_PRODUCTION_MODE=
CLOUDPEN_SIGNER_URL=
CLOUDPEN_SIGNER_TOKEN=
CLOUDPEN_SIGNING_KEY_ID=
CLOUDPEN_SIGNING_PUBLIC_JWK=

# Production-only independently administered security-event collector.
CLOUDPEN_SIEM_URL=
CLOUDPEN_SIEM_TOKEN=

CLOUDPEN_WORKSPACE_ID=northstar-labs
PUBLIC_APP_ORIGIN=http://127.0.0.1:3000
